/*
 * -profile test: tiny dataset hosted on Zenodo (~16 MB, downloaded at run time)
 *
 *   Genome: eight 1-Mb GRCh38 windows joined into chr1/chr2 (built by tests/make_test_data.sh)
 *   Reads:  810-1,460 long reads per sample, GM12878 (control) x2 and H1 (treatment) x2
 *
 * Runs from any directory, e.g.
 *   nextflow run YidanSunResearchLab/nf-LongIso -r v0.2.0 -profile test,singularity --outdir results_test
 *   nextflow run main.nf -profile test,docker -stub --outdir results_stub
 */

params {
    // Test data record: https://doi.org/10.5281/zenodo.24420794
    samplesheet = "${projectDir}/tests/samplesheet_test.csv"
    genome      = 'https://zenodo.org/records/24420794/files/genome.fa'
    gtf         = 'https://zenodo.org/records/24420794/files/genes.gtf'
    te_gtf      = 'https://zenodo.org/records/24420794/files/te.gtf'
    max_cpus    = 2
    max_memory  = '6.GB'
    max_time    = '2.h'
}

// Set the limits directly: the main config computes resourceLimits before profile params apply
process {
    resourceLimits = [ cpus: 2, memory: 6.GB, time: 2.h ]
}
