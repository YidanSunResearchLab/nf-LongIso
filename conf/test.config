/*
 * -profile test: tiny dataset in tests/data (~17 MB)
 *
 *   Genome: eight 1-Mb GRCh38 windows joined into chr1/chr2 (tests/make_test_data.sh)
 *   Reads:  810-1,460 long reads per sample, GM12878 (control) x2 and H1 (treatment) x2
 *
 * Run from the repository root (samplesheet paths are relative to it), e.g.
 *   nextflow run main.nf -profile test,singularity --outdir results_test
 *   nextflow run main.nf -profile test,docker -stub --outdir results_stub
 */

params {
    samplesheet = "tests/data/samplesheet.csv"
    genome      = "${projectDir}/tests/data/genome.fa"
    gtf         = "${projectDir}/tests/data/genes.gtf"
    te_gtf      = "${projectDir}/tests/data/te.gtf"
    max_cpus    = 2
    max_memory  = '6.GB'
    max_time    = '2.h'
}

// Set the limits directly: the main config computes resourceLimits before profile params apply
process {
    resourceLimits = [ cpus: 2, memory: 6.GB, time: 2.h ]
}
