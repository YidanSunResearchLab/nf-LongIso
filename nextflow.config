/*
 * NextLongIso (nf-LongIso) - pipeline configuration
 *
 * Resource requests below are base values that grow with task.attempt on retry.
 * Every request is capped by process.resourceLimits (--max_cpus / --max_memory / --max_time).
 */

manifest {
    name            = 'YidanSunResearchLab/nf-LongIso'
    description     = 'NextLongIso: a Nextflow pipeline for multi-dimensional long-read RNA-seq analysis (isoforms, splicing, APA, promoters and transposable elements)'
    contributors    = [
        [ name: 'Jiang', affiliation: 'Yidan Sun Research Lab' ]
    ]
    homePage        = 'https://github.com/YidanSunResearchLab/nf-LongIso'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.0'
    version         = '0.2.0'
}

plugins {
    id 'nf-schema@2.7.3'
}

params {
    // Input / reference
    samplesheet         = null
    input_type          = 'fastq'
    genome              = null
    gtf                 = null
    te_gtf              = null

    // Output
    outdir              = 'results'
    publish_dir_mode    = 'copy'
    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

    // Alignment (minimap2)
    minimap2_preset     = 'splice'   // 'splice:hq' for PacBio Iso-Seq / high-accuracy reads
    minimap2_args       = ''         // extra alignment options, appended after the defaults
    minimap2_junc_bed   = true       // guide alignment with GTF-derived junctions (--junc-bed)
    minimap2_index      = null       // pre-built .mmi index; skips MINIMAP2_INDEX
    minimap2_index_args = ''         // index-building options such as -k, -w, -H

    // Junctions
    junction_min_mapq   = 0          // minimum MAPQ of reads used for junctions (0 = all primary alignments)

    // Tool arguments (appended after the pipeline defaults)
    bamcoverage_args    = ''         // extra bamCoverage options
    bambu_args          = ''         // extra R arguments to bambu(), e.g. 'NDR = 0.1' (double quotes only)
    suppa2_events       = 'SE SS MX RI FL'   // SUPPA2 generateEvents event types

    // Differential analyses
    design               = '~ condition'   // design formula over samplesheet columns, condition last
    reference_condition  = null      // default: 'control' if present, else the alphabetically first condition
    isoswitch_alpha      = 0.05      // q-value cutoff for switches and APA
    isoswitch_dif_cutoff = 0.1       // |dIF| cutoff for significant switches
    usage_alpha          = 0.05      // gene q-value cutoff for differential PAS / promoter usage (DEXSeq)

    // Alternative polyadenylation
    apa_cluster_window    = 25       // 3' ends closer than this (bp) are clustered
    apa_max_cluster_width = 50       // maximal width of a PAS cluster (bp)
    apa_ip_a_frac         = 0.7      // A fraction of the 20 nt downstream that flags internal priming
    apa_internal_priming  = 'filter' // 'filter' or 'flag' suspected internal-priming ends of novel transcripts
    apa_min_count         = 10       // minimal reads of a PAS over all samples

    // Transposable elements (used with --te_gtf)
    te_count_mode       = 'exon'     // 'exon' (exon-TE overlap) or 'span' (v0.1.0 transcript-span counting)
    te_min_overlap      = 20         // minimum exon-TE overlap (bp)
    te_strand           = 'sense'    // 'sense' (TE on the transcript strand) or 'both'
    te_autonomous_frac  = 0.5        // TE fraction of exonic length for category 'autonomous'

    // Promoter analysis (proActiv)
    proactiv_species      = 'Homo_sapiens'
    proactiv_altprom_args = 'minAbs = 0.25, minRel = 0.05, maxPval = 0.05, promoterFC = 2.0, geneFC = 1.5'

    // Help (handled by nf-schema)
    help                = false
    helpFull            = false
    showHidden          = false

    // Resource limits (caps for every process request)
    max_cpus            = 16
    max_memory          = '128.GB'
    max_time            = '72.h'

    // HPC executors (used by the slurm and lsf profiles)
    hpc_queue           = null
    hpc_cluster_options = null
}

profiles {
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        singularity.cacheDir    = "${projectDir}/singularity_cache"
        singularity.pullTimeout = '1 h'
        apptainer.enabled       = false
        docker.enabled          = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        apptainer.cacheDir      = "${projectDir}/singularity_cache"
        apptainer.pullTimeout   = '1 h'
        singularity.enabled     = false
        docker.enabled          = false
    }
    docker {
        docker.enabled          = true
        docker.runOptions       = '-u $(id -u):$(id -g)'
        singularity.enabled     = false
        apptainer.enabled       = false
    }
    slurm {
        process.executor        = 'slurm'
        process.queue           = { params.hpc_queue }
        process.clusterOptions  = { params.hpc_cluster_options }
    }
    test {
        includeConfig 'conf/test.config'
    }
    lsf {
        process.executor        = 'lsf'
        process.queue           = { params.hpc_queue }
        process.clusterOptions  = { params.hpc_cluster_options }
        executor.perJobMemLimit = true
    }
}

process {
    resourceLimits = [
        cpus:   params.max_cpus as int,
        memory: params.max_memory,
        time:   params.max_time
    ]

    // Defaults for any process without its own block
    cpus   = 2
    memory = { 8.GB * task.attempt }
    time   = { 8.h  * task.attempt }

    // Retry on resource-related exit codes (OOM kill, SIGTERM, SIGSEGV, scheduler limits)
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2

    // Containers (no "docker://" prefix: Nextflow adds the right scheme for each engine)
    // minimap2 2.28 + samtools 1.20 (mulled image used by nf-core/modules minimap2/align until 2025-02)
    withName: 'MINIMAP2_INDEX|JUNC_BED|MINIMAP2_ALIGN' {
        container = 'quay.io/biocontainers/mulled-v2-66534bcbb7031a148b13e2ad42583020b9cd25c4:3161f532a5ea6f1dec9be5667c9efc2afdac6104-0'
    }
    withName: MINIMAP2_INDEX {
        cpus      = 8
        memory    = { 32.GB * task.attempt }
        ext.args  = { params.minimap2_index_args }
    }
    withName: JUNC_BED {
        cpus      = 1
        memory    = { 4.GB * task.attempt }
    }
    withName: MINIMAP2_ALIGN {
        cpus      = 16
        memory    = { 32.GB * task.attempt }
        time      = { 24.h * task.attempt }
        ext.args  = { params.minimap2_args }
    }
    withName: 'SAMTOOLS_INDEX|SAMTOOLS_STATS|EXTRACT_JUNCTIONS|SAMTOOLS_FAIDX|GTF_INTRONS' {
        container = 'quay.io/biocontainers/samtools:1.19.2--h50ea8bc_1'
        cpus      = 4
        memory    = { 8.GB * task.attempt }
    }
    withName: MAKE_BIGWIG {
        container = 'quay.io/biocontainers/deeptools:3.5.5--pyhdfd78af_0'
        cpus      = 8
        memory    = { 16.GB * task.attempt }
        ext.args  = { params.bamcoverage_args }
    }
    withName: BAMBU_PREP {
        container = 'quay.io/biocontainers/bioconductor-bambu:3.12.1--r44he5774e6_0'
        cpus      = 2
        memory    = { 16.GB * task.attempt }
    }
    withName: BAMBU {
        container = 'quay.io/biocontainers/bioconductor-bambu:3.12.1--r44he5774e6_0'
        cpus      = 16
        memory    = { 48.GB * task.attempt }
        time      = { 24.h * task.attempt }
        ext.args  = { params.bambu_args }
    }
    withName: SUPPA2 {
        container = 'quay.io/biocontainers/suppa:2.4--pyhdfd78af_0'
        cpus      = 2
        memory    = { 8.GB * task.attempt }
    }
    withName: 'DESEQ2|TE_DESEQ2' {
        container = 'quay.io/biocontainers/bioconductor-deseq2:1.46.0--r44he5774e6_1'
        cpus      = 2
        memory    = { 8.GB * task.attempt }
    }
    withName: ISOSWITCH {
        container = 'quay.io/biocontainers/bioconductor-isoformswitchanalyzer:2.6.0--r44h3df3fcb_0'
        cpus      = 4
        memory    = { 16.GB * task.attempt }
        time      = { 24.h * task.attempt }
    }
    withName: PROACTIV {
        container = 'quay.io/biocontainers/bioconductor-proactiv:1.16.0--r44hdfd78af_0'
        cpus      = 8
        memory    = { 32.GB * task.attempt }
        ext.args  = { params.proactiv_altprom_args }
    }
    withName: APA {
        container = 'quay.io/biocontainers/bioconductor-isoformswitchanalyzer:2.6.0--r44h3df3fcb_0'
        cpus      = 4
        memory    = { 16.GB * task.attempt }
    }
    withName: TE_ANALYSIS {
        container = 'quay.io/biocontainers/bedtools:2.31.1--h13024bc_3'
        cpus      = 2
        memory    = { 16.GB * task.attempt }
    }
    withName: MAKE_DESIGN {
        container = 'quay.io/biocontainers/bioconductor-deseq2:1.46.0--r44he5774e6_1'
        cpus      = 1
        memory    = { 2.GB * task.attempt }
    }
    withName: 'MULTIQC|SOFTWARE_VERSIONS' {
        container = 'quay.io/biocontainers/multiqc:1.33--pyhdfd78af_0'
        cpus      = 2
        memory    = { 8.GB * task.attempt }
    }
}

validation {
    help {
        enabled = true
        command = "nextflow run YidanSunResearchLab/nf-LongIso -profile singularity --samplesheet samplesheet.csv --genome genome.fa --gtf annotation.gtf --outdir results"
    }
    summary {
        hideParams = ['trace_report_suffix']
    }
    logging {
        // Extra samplesheet columns are allowed (covariates for --design)
        unrecognisedHeaders = 'skip'
    }
}

// Execution reports, written to <outdir>/pipeline_info/ with a timestamp suffix
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}
