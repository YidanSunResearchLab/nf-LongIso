/*
 * NextLongIso (nf-LongIso) - pipeline configuration
 *
 * Resource requests below are base values that grow with task.attempt on retry.
 * Every request is capped by process.resourceLimits (--max_cpus / --max_memory / --max_time).
 */

manifest {
    name            = 'YidanSunResearchLab/nf-LongIso'
    description     = 'NextLongIso: a Nextflow pipeline for multi-dimensional long-read RNA-seq analysis (isoforms, splicing, APA, promoters and transposable elements)'
    contributors    = [
        [ name: 'Jiang', affiliation: 'Yidan Sun Research Lab' ]
    ]
    homePage        = 'https://github.com/YidanSunResearchLab/nf-LongIso'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.0'
    version         = '0.2.0'
}

params {
    // Input / reference
    samplesheet         = null
    input_type          = 'fastq'
    genome              = null
    gtf                 = null
    te_gtf              = null

    // Output
    outdir              = 'results'
    publish_dir_mode    = 'copy'
    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

    // Resource limits (caps for every process request)
    max_cpus            = 16
    max_memory          = '128.GB'
    max_time            = '72.h'

    // HPC executors (used by the slurm and lsf profiles)
    hpc_queue           = null
    hpc_cluster_options = null
}

profiles {
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        singularity.cacheDir    = "${projectDir}/singularity_cache"
        singularity.pullTimeout = '1 h'
        apptainer.enabled       = false
        docker.enabled          = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        apptainer.cacheDir      = "${projectDir}/singularity_cache"
        apptainer.pullTimeout   = '1 h'
        singularity.enabled     = false
        docker.enabled          = false
    }
    docker {
        docker.enabled          = true
        docker.runOptions       = '-u $(id -u):$(id -g)'
        singularity.enabled     = false
        apptainer.enabled       = false
    }
    slurm {
        process.executor        = 'slurm'
        process.queue           = { params.hpc_queue }
        process.clusterOptions  = { params.hpc_cluster_options }
    }
    lsf {
        process.executor        = 'lsf'
        process.queue           = { params.hpc_queue }
        process.clusterOptions  = { params.hpc_cluster_options }
        executor.perJobMemLimit = true
    }
}

process {
    resourceLimits = [
        cpus:   params.max_cpus as int,
        memory: params.max_memory,
        time:   params.max_time
    ]

    // Defaults for any process without its own block
    cpus   = 2
    memory = { 8.GB * task.attempt }
    time   = { 8.h  * task.attempt }

    // Retry on resource-related exit codes (OOM kill, SIGTERM, SIGSEGV, scheduler limits)
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2

    // Containers (no "docker://" prefix: Nextflow adds the right scheme for each engine)
    withName: MINIMAP2 {
        container = 'quay.io/biocontainers/minimap2:2.28--he4a0461_0'
        cpus      = 16
        memory    = { 32.GB * task.attempt }
    }
    withName: 'SAMTOOLS_SORT|EXTRACT_JUNCTIONS' {
        container = 'quay.io/biocontainers/samtools:1.19.2--h50ea8bc_1'
        cpus      = 4
        memory    = { 8.GB * task.attempt }
    }
    withName: MAKE_BIGWIG {
        container = 'quay.io/biocontainers/deeptools:3.5.5--pyhdfd78af_0'
        cpus      = 8
        memory    = { 16.GB * task.attempt }
    }
    withName: BAMBU_PREP {
        container = 'quay.io/biocontainers/bioconductor-bambu:3.12.1--r44he5774e6_0'
        cpus      = 2
        memory    = { 16.GB * task.attempt }
    }
    withName: BAMBU {
        container = 'quay.io/biocontainers/bioconductor-bambu:3.12.1--r44he5774e6_0'
        cpus      = 16
        memory    = { 48.GB * task.attempt }
        time      = { 24.h * task.attempt }
    }
    withName: SUPPA2 {
        container = 'quay.io/biocontainers/suppa:2.4--pyhdfd78af_0'
        cpus      = 2
        memory    = { 8.GB * task.attempt }
    }
    withName: 'DESEQ2|TE_DESEQ2' {
        container = 'quay.io/biocontainers/bioconductor-deseq2:1.46.0--r44he5774e6_1'
        cpus      = 2
        memory    = { 8.GB * task.attempt }
    }
    withName: ISOSWITCH {
        container = 'quay.io/biocontainers/bioconductor-isoformswitchanalyzer:2.6.0--r44h3df3fcb_0'
        cpus      = 4
        memory    = { 16.GB * task.attempt }
        time      = { 24.h * task.attempt }
    }
    withName: PROACTIV {
        container = 'quay.io/biocontainers/bioconductor-proactiv:1.16.0--r44hdfd78af_0'
        cpus      = 8
        memory    = { 32.GB * task.attempt }
    }
    withName: TE_ANALYSIS {
        container = 'quay.io/biocontainers/bedtools:2.31.1--h13024bc_3'
        cpus      = 2
        memory    = { 16.GB * task.attempt }
    }
    withName: MULTIQC {
        container = 'quay.io/biocontainers/multiqc:1.33--pyhdfd78af_0'
        cpus      = 2
        memory    = { 8.GB * task.attempt }
    }
}

// Execution reports, written to <outdir>/pipeline_info/ with a timestamp suffix
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}
